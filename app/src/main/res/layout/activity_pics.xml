<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <View
        android:id="@+id/read_wall"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF000000" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_pics"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="vertical" />

    <ProgressBar
        android:id="@+id/loading"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:background="#99000000"
        android:padding="12dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_reader_back"
            android:background="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="16sp"
            android:textColor="#FFEAF2F8"
            android:singleLine="true"
            android:ellipsize="end"
            android:layout_marginStart="12dp" />

        <TextView
            android:id="@+id/tv_chapter"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="14sp"
            android:textColor="#FF9FB3C8"
            android:singleLine="true"
            android:ellipsize="end"
            android:gravity="end" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="#99000000"
        android:padding="8dp">

        <SeekBar
            android:id="@+id/seek_chapter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <ImageView
                android:id="@+id/btn_prev_ch"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_reader_prev"
                android:background="?attr/selectableItemBackground" />
            <ImageView
                android:id="@+id/btn_mode"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_reader_anim"
                android:layout_marginHorizontal="8dp"
                android:background="?attr/selectableItemBackground" />
            <ImageView
                android:id="@+id/btn_auto"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_reader_auto"
                android:layout_marginHorizontal="8dp"
                android:background="?attr/selectableItemBackground" />
            <ImageView
                android:id="@+id/btn_settings"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_reader_settings"
                android:layout_marginHorizontal="8dp"
                android:background="?attr/selectableItemBackground" />
            <ImageView
                android:id="@+id/btn_next_ch"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_reader_next"
                android:background="?attr/selectableItemBackground" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/panel_settings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="#E61A1A1A"
        android:padding="16dp"
        android:visibility="gone">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:layout_width="80dp" android:layout_height="wrap_content" android:text="亮度" android:textColor="#FFEAF2F8" />
            <SeekBar android:id="@+id/seek_brightness" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:max="100" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:layout_width="80dp" android:layout_height="wrap_content" android:text="滚动速度" android:textColor="#FFEAF2F8" />
            <SeekBar android:id="@+id/seek_auto" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:max="100" android:progress="50" />
        </LinearLayout>
        <ImageView
            android:id="@+id/btn_settings_close"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="end"
            android:layout_marginTop="8dp"
            android:src="@drawable/ic_reader_close" />
    </LinearLayout>

</FrameLayout>
